---
// src/components/FeatureCard.astro
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<article class="rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-black)] p-6 shadow-sm h-full">
  <div class="m-0 flex items-center gap-3 text-lg font-semibold text-[var(--sl-color-white)]">
    <slot name="icon" />
    <span>{title}</span>
  </div>
  <div class="mt-4 text-[var(--sl-color-gray-3)] text-sm leading-relaxed">
    <slot />
  </div>
</article>
