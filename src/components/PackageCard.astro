---
import { TbApi } from "react-icons/tb";
import NpmStats from "./NpmStats.tsx";

interface Props {
  title: string;
  description: string;
  guideLink: string;
  sourceLink: string;
  type: "api" | "auth" | "baileys";
  npmPackage?: string;
}

const { title, description, guideLink, sourceLink, type, npmPackage } = Astro.props;
---

<div class="flex flex-col bg-white dark:bg-[#111113] border border-gray-200 dark:border-gray-800 rounded-[2rem] p-8 shadow-sm hover:shadow-md transition-shadow h-full">
  <!-- Logo Section -->
  <div class="flex items-center justify-center w-[120px] h-[120px] mb-6 rounded-[1.5rem] overflow-hidden shrink-0 bg-gray-50 dark:bg-[#1a1a1c]">
    {type === 'api' && (
      <div class="w-full h-full bg-yellow-400 flex items-center justify-center">
        <TbApi className="w-16 h-16 text-black" />
      </div>
    )}
    {type === 'auth' && (
      <img src="/ht_iconAccount.svg" alt="Heavstal Auth Logo" class="w-full h-full object-contain p-2" />
    )}
    {type === 'baileys' && (
      <img src="/baileys.svg" alt="HT Baileys Logo" class="w-full h-full object-contain p-2" />
    )}
  </div>

  <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">{title}</h3>

  <NpmStats packageName={npmPackage} client:load />

  <p class="text-gray-600 dark:text-gray-400 text-sm flex-grow mb-8 leading-relaxed">
    {description}
  </p>

  <div class="flex justify-between items-center w-full mt-auto">
    <a 
      href={guideLink} 
      class="no-underline px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-full transition-colors"
    >
      Guide
    </a>
    
    <a 
      href={sourceLink} 
      target="_blank" 
      rel="noopener noreferrer"
      class="no-underline px-6 py-2.5 bg-gray-100 dark:bg-gray-800/80 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm font-semibold rounded-full transition-colors"
    >
      Source
    </a>
  </div>
</div>
