---
// src/components/PackageManagers.astro
import { Tabs, TabItem, Code } from '@astrojs/starlight/components';

interface Props {
  pkg: string | string[]; 
  githubRepo?: string | string[];
}

const { pkg, githubRepo } = Astro.props;
const pkgString = Array.isArray(pkg) ? pkg.join(' ') : pkg;

const githubString = githubRepo 
  ? (Array.isArray(githubRepo) ? githubRepo.map(repo => `github:${repo}`).join(' ') : `github:${githubRepo}`)
  : '';
---

<Tabs syncKey="package-manager">
  <TabItem label="npm">
    <Code code={`npm install ${pkgString}`} lang="bash" />
  </TabItem>
  <TabItem label="yarn">
    <Code code={`yarn add ${pkgString}`} lang="bash" />
  </TabItem>
  <TabItem label="pnpm">
    <Code code={`pnpm add ${pkgString}`} lang="bash" />
  </TabItem>
  <TabItem label="bun">
    <Code code={`bun add ${pkgString}`} lang="bash" />
  </TabItem>
  
  {githubRepo && (
    <TabItem label="GitHub">
      <Code code={`# Latest development version\nnpm install ${githubString}`} lang="bash" />
    </TabItem>
  )}
</Tabs>
