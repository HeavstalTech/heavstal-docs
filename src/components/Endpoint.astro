---
// src/components/Endpoint.astro
import MethodBadge from './MethodBadge.astro'

interface Props {
  method: string;
  url: string;
}

const { method, url } = Astro.props;
---

<div class="endpoint-box">
  <MethodBadge method={method} />
  <code>{url}</code>
</div>

<style>
  .endpoint-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background-color: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  
  .endpoint-box code {
    font-size: 0.9rem;
    background: transparent;
    padding: 0;
    border: none;
    color: var(--sl-color-text);
  }
</style>
