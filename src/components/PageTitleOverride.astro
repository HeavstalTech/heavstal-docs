---
// src/components/PageTitleOverride.astro
import Default from '@astrojs/starlight/components/PageTitle.astro'
import MarkdownActions from './MarkdownActions'

// --- DEBUG LOGGING ---
// Log
console.log('--- PageTitleOverride Props for:', Astro.url.pathname, '---');
console.log('Template:', Astro.props.entry?.data?.template);
console.log('HideTitle:', Astro.props.entry?.data?.hideTitle);
console.log('Full Props:', Astro.props)
// ---------------------

const { entry } = Astro.props
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const isSplash = entry?.data?.template === 'splash'
const hideTitle = isHomePage || isSplash || entry?.data?.hideTitle === true;

const pathname = Astro.url.pathname.replace(/\/$/, '');
const mdPath = pathname === '' ? '/index.md' : `${pathname}.md`;
const txtPath = pathname === '' ? '/index.txt' : `${pathname}.txt`;
const fullMdUrl = new URL(mdPath, Astro.url.origin).href;
const fullTxtUrl = new URL(txtPath, Astro.url.origin).href;
---

{!hideTitle && (
  <div class="mb-6">
    <Default {...Astro.props} />
    
    <div class="mt-4 flex justify-start sm:justify-end">
      <MarkdownActions 
        client:idle 
        rawMarkdown={entry?.body || ''} 
        mdUrl={fullMdUrl} 
        txtUrl={fullTxtUrl}
      />
    </div>
  </div>
)}
