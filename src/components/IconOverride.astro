/* Not supported by Astro
---
// Docs/src/components/IconOverride.astro
// @ts-ignore
import Default from '@astrojs/starlight/components/Icon.astro';
import { 
  SiJavascript, 
  SiPython, 
  SiNpm, 
  SiYarn, 
  SiPnpm, 
  SiGnubash 
} from 'react-icons/si';

const { name, size, class: className, ...rest } = Astro.props;
const iconSize = size || "1.3em";
const iconClass = `custom-brand-icon ${className || ''}`.trim();
const reactProps = { size: iconSize, className: iconClass };
---

{name === 'heavstal' ? (
  <img 
    src="/heavstal.svg" 
    class={iconClass} 
    style={`width: ${iconSize}; height: ${iconSize};`} 
    alt="Heavstal" 
  />
) : name === 'seti:javascript' ? (
  <SiJavascript color="#F7DF1E" {...reactProps} />
) : name === 'seti:python' ? (
  <SiPython color="#3776AB" {...reactProps} />
) : (name === 'seti:npm' || name === 'npm') ? (
  <SiNpm color="#CB3837" {...reactProps} />
) : (name === 'seti:yarn' || name === 'yarn') ? (
  <SiYarn color="#2C8EBB" {...reactProps} />
) : (name === 'seti:pnpm' || name === 'pnpm') ? (
  <SiPnpm color="#F69220" {...reactProps} />
) : name === 'seti:shell' ? (
  <SiGnubash color="#4EAA25" {...reactProps} />
) : (
  <Default name={name} size={size} class={className} {...rest} />
)}

<style is:global>
  .custom-brand-icon {
    display: inline-block;
    vertical-align: text-bottom;
  }
</style>
