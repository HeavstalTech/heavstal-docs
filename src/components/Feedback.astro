---
//src/components/Feedback.astro
import Default from '@astrojs/starlight/components/Pagination.astro';
import FeedbackWidget from './FeedbackWidget';

const { entry } = Astro.props;
// const hidePagination = entry.data.hidePagination;
const hidePagination = entry?.data?.hidePagination === true;
---

{!hidePagination && (
  <>
    <FeedbackWidget client:idle />
    <div class="h-2"></div>
    <Default {...Astro.props} />
  </>
)}
