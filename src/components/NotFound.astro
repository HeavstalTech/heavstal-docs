---
// src/components/NotFound.astro
---

<style is:global>
  header.header { display: none !important; }
  .page { padding-top: 0 !important; }
  .main-pane { width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
  .sl-container { max-width: 100% !important; margin: 0 !important; padding: 0 !important; }
  .content-panel { padding: 0 !important; border: none !important; }
  .sl-markdown-content { padding: 0 !important; }
</style>

<div class="min-h-screen flex items-center justify-center p-6 bg-white dark:bg-[#151b23] text-gray-900 dark:text-gray-100 font-sans">
  <div class="max-w-6xl w-full flex flex-col-reverse md:flex-row items-center justify-between gap-12 md:gap-8">
    
    <div class="flex-1 space-y-6 text-center md:text-left">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight mt-0">
        Yohzaw! Where are you going?
      </h1>
      
      <div class="space-y-3 text-lg text-gray-600 dark:text-gray-400">
        <p>Were you looking for a page that used to be here?</p>
        <p>
          Why not contact <a href="https://support.heavstal.com.ng" target="_blank" rel="noreferrer" class="text-[#1a73e8] dark:text-[#8ab4f8] hover:underline font-medium">support</a> and know what happened?
        </p>
      </div>

      <div class="pt-6 flex justify-center md:justify-start">
        <a 
          href="/"
          class="flex items-center justify-center gap-2 px-8 py-3.5 bg-[#1a73e8] hover:bg-[#1557b0] !text-white rounded-lg font-bold text-sm shadow-sm transition-all hover:-translate-y-0.5 w-full sm:w-auto no-underline"
        >
          <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="20" width="20" xmlns="http://www.w3.org/2000/svg">
            <path d="M144.1 32.1C102.7 44 48 64 48 64v384s54.7-20 96.1-31.9C185.5 404.2 288 384 288 384V32s-102.5 20-143.9 31.9zM256 224v64h-32v-64h32zM432 96h-32v32h32v256h-32v32h32c17.7 0 32-14.3 32-32V128c0-17.7-14.3-32-32-32zM336 192v128h64V192h-64z"></path>
          </svg>
          Exit Page
        </a>
      </div>
    </div>

    <div class="flex-1 w-full flex justify-center md:justify-end">
      <img 
        src="https://heavstal.com.ng/BrokenRobot.svg"
        alt="404 Broken Robot" 
        width="500" 
        height="500" 
        class="w-full max-w-[280px] md:max-w-[450px] lg:max-w-[500px] object-contain dark:invert opacity-90"
      />
    </div>

  </div>
</div>
