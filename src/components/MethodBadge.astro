---
// src/components/MethodBadge.astro
import { ArrowDownRight, ArrowUpRight, X, Edit3, RefreshCcw } from 'lucide-react';

const { method } = Astro.props;
const methodUpper = method.toUpperCase();

const config = {
  GET: { 
    color: '#22c55e', bg: 'rgba(34, 197, 94, 0.1)',
    Icon: ArrowDownRight 
  },
  POST: { 
    color: '#3b82f6', bg: 'rgba(59, 130, 246, 0.1)',
    Icon: ArrowUpRight 
  },
  PUT: { 
    color: '#f97316', bg: 'rgba(249, 115, 22, 0.1)',
    Icon: RefreshCcw 
  },
  PATCH: {
    color: '#a855f7', bg: 'rgba(168, 85, 247, 0.1)',
    Icon: Edit3 
  },
  DELETE: { 
    color: '#ef4444', bg: 'rgba(239, 68, 68, 0.1)',
    Icon: X 
  },
};

const style = config[methodUpper] || config.GET;
const IconComponent = style.Icon;
---

<span class="method-badge" style={`--theme-color: ${style.color}; --theme-bg: ${style.bg};`}>
  <!-- Astro will render this React component as static HTML! -->
  <IconComponent size={14} strokeWidth={2.5} />
  {methodUpper}
</span>

<style>
  .method-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    border: 1px solid var(--theme-color);
    color: var(--theme-color);
    background-color: var(--theme-bg);
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
</style>
